[API]
Host = "127.0.0.1"
Port = 7100
Token = "A0473A67-27A1-3C05-A2D1-5C134639347F"

[NDTP]
Host = "195.122.228.34"
Port = 4876

[System]
LogDir =  "/data/NDTPClient/log/nn-tram-client.log"
Timeout = 15 
PeerAddr = 706197201
Disconnect = true  	# false -- каждый навигац. пакет в новом соединении, true -- непрерывное соединение
Regular = true 		# true -- отправка раз в interval, false -- единичный пакет
Interval = 15
ServerPort = 4050  	# Порт на котором находятся все эндпоинты

[History]
HistDir = "/data/NDTPClient/db/nn-tram-hist.db"
MaxRecords = 150000
CleanInterval = 20

[Message] #Для отправки сообщений (SED) в Message API
LogDir = "/data/NDTPClient/log/nn-tram-MessageLog.log"
APIAddr = "localhost"
APIPort = 7200
APIEndpoint = "/api/message-relay/inbound-server-message"
